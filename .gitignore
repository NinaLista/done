# Jekyll build output and caches
_site/
.jekyll-cache/
.jekyll-metadata

# Sass cache; Sass is a CSS preprocessor
.sass-cache/

# Ruby/Jekyll dependency folders if local tooling is used
.bundle/
vendor/bundle/

# JavaScript dependencies if npm tooling is introduced later
node_modules/

# Local editor / operating-system files
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.vscode/
.idea/

# Temporary editor files
*~
*.swp

# Environment files; may contain secrets
.env
.env.*

# Common private key / certificate files
*.pem
*.p12
*.pfx
*.key
